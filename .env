# ========================================================
# LOKA FRONTEND PRODUCTION ENVIRONMENT
# Salin file ini menjadi frontend/.env.production sebelum build:
# npm run build
# ========================================================

# Masukkan domain/IP backend API yang berjalan di Azure VM:
# Contoh jika menggunakan subdomain:
VITE_API_URL=https://ruubia.my.id

# Atau jika langsung IP Azure VM tanpa domain (HTTP):
# VITE_API_URL=http://<IP_PUBLIC_AZURE_VM>:5000
